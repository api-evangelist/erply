{
  "opencollection": "1.0.0",
  "info": {
    "name": "assignments Assortment task API",
    "version": "2.36.5"
  },
  "items": [
    {
      "info": {
        "name": "task",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Look up any tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/task",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "query",
                "description": "Task ID-s"
              },
              {
                "name": "type",
                "value": "lunchbreak",
                "type": "query",
                "description": "Task types. By default returns all"
              },
              {
                "name": "workorderId",
                "value": "1",
                "type": "query",
                "description": "List of workorder ID-s"
              },
              {
                "name": "workorderCustomerId",
                "value": "1",
                "type": "query",
                "description": "Workorder customer ID-s"
              },
              {
                "name": "workorderContactId",
                "value": "1",
                "type": "query",
                "description": "Workorder contact ID-s"
              },
              {
                "name": "itemId",
                "value": "1",
                "type": "query",
                "description": "List of item ID-s"
              },
              {
                "name": "rowId",
                "value": "1",
                "type": "query",
                "description": "List of row ID-s"
              },
              {
                "name": "rowProductId",
                "value": "1",
                "type": "query",
                "description": "List of row product ID-s"
              },
              {
                "name": "rowProductCode",
                "value": "1",
                "type": "query",
                "description": "List of row product codes"
              },
              {
                "name": "rowProductGroupId",
                "value": "1",
                "type": "query",
                "description": "List of row product group ID-s"
              },
              {
                "name": "rowTitleLike",
                "value": "1",
                "type": "query",
                "description": "Row title matching"
              },
              {
                "name": "warehouseId",
                "value": "1",
                "type": "query",
                "description": "List of workorder warehouse ID-s"
              },
              {
                "name": "resourceId",
                "value": "1",
                "type": "query",
                "description": "List of resource ID-s"
              },
              {
                "name": "assignedToId",
                "value": "1",
                "type": "query",
                "description": "List of assigned-to Employee ID-s"
              },
              {
                "name": "rangeStart",
                "value": "2020-06-06T13:55:00Z",
                "type": "query",
                "description": "Task time range lower bound (yyyy-mm-ddThh:mm:ssZ or a UNIX timestamp). Defaults to Unix Epoch. If no filtering by workorder, item or row ID is applied, difference between rangeStart and rangeEnd must be less than 61 days"
              },
              {
                "name": "rangeEnd",
                "value": "2020-06-06T13:55:00Z",
                "type": "query",
                "description": "Task time range upper bound (yyyy-mm-ddThh:mm:ssZ or a UNIX timestamp). Defaults to NOW. If no filtering by workorder, item or row ID is applied, difference between rangeStart and rangeEnd must be less than 61 days"
              },
              {
                "name": "rangeStrict",
                "value": "true",
                "type": "query",
                "description": "If task start and end time must fit entirely inside the filter range"
              },
              {
                "name": "withRowNotes",
                "value": "true",
                "type": "query",
                "description": "If linked row notes should also be returned in the response"
              },
              {
                "name": "labelType",
                "value": "",
                "type": "query",
                "description": "Label type"
              },
              {
                "name": "label",
                "value": "",
                "type": "query",
                "description": "Labels under the specified type that must match"
              },
              {
                "name": "withTotalCount",
                "value": "true",
                "type": "query",
                "description": "If total matching record count should be return in response header"
              },
              {
                "name": "pageSize",
                "value": "30",
                "type": "query",
                "description": "Result page size. Defaults to 20"
              },
              {
                "name": "pageNr",
                "value": "2",
                "type": "query",
                "description": "Result page number. Defaults to 1"
              },
              {
                "name": "sort",
                "value": "-id",
                "type": "query",
                "description": "Allows specifying in which order the rows should be returned. Supported values are: `id`, `startAt`. It is possible to reverse the order by adding a `-` prefix to the sorting keyword"
              }
            ]
          },
          "docs": "Look up any tasks"
        },
        {
          "info": {
            "name": "Add a new task record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/task"
          },
          "docs": "Add a new task record"
        },
        {
          "info": {
            "name": "Reschedule tasks if so configured",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/task/reschedule"
          },
          "docs": "Allows to execute task rescheduling logic if the account has been configured accordingly. When triggered, tasks which were left unclosed (in states other that `done`) in the account's timezone yesterday, will be rescheduled for today and set to `blocked` state.\r\n\r\n#### Configuration ####\r\n\r\nFunctionality can be enabled or disabled in Cafa. If there is no configuration in Cafa, calling this function will generate a Cafa entry with default values.\r\n\r\n> Field         | Value&nbsp;       | Descripti"
        },
        {
          "info": {
            "name": "Update task record",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/task/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task id"
              }
            ]
          },
          "docs": "Update task record"
        },
        {
          "info": {
            "name": "Delete one task record",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/task/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task id"
              }
            ]
          },
          "docs": "Delete one task record"
        },
        {
          "info": {
            "name": "Delete one task within a recurring task chain",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/task/:taskId/:repeatId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task id"
              },
              {
                "name": "repeatId",
                "value": "",
                "type": "path",
                "description": "Recurring task repeatId"
              }
            ]
          },
          "docs": "Delete one task within a recurring task chain"
        }
      ]
    }
  ],
  "bundled": true
}