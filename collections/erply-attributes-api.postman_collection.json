    {
      "id": "5a4ed618-e840-4c6d-a3fb-6eae6d031fc4",
      "name": "Attributes",
      "description": {
        "content": "Attributes are attached to entities. The possible entities are: product, recipe, warehouse location, assortment, brand, matrix dimension, matrix dimension value, category, country, family, group, package, parameter, parameter option, parameter set, parameter validation rule, parameter value, unit, supplier",
        "type": "text/plain"
      },
