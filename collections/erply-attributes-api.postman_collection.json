          "name": "Attach / Update an Attribute",
          "request": {
            "name": "Attach / Update an Attribute",
            "description": {
              "content": "To Create an attribute you must leave the id field empty. To Update you must specify the ID field. RecordID refers to the object that the attribute will be attached to. Product / invoice / customer, etc.\nName cannot have spaces and is limited to 50 characters. One database record must not have multiple attributes with the same name.\n3 `types` are available - int, double, text. Based on the type the `value` should be number of text.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "attribute"
