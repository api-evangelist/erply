          "id": "b83cbe3f-9eca-4a7d-9e4b-39f69b1d4489",
          "name": "Search product with special franchise rules",
          "request": {
            "name": "Search product with special franchise rules",
            "description": {
              "content": "Searches for products in both current store and its hq.\nIf the desired product does not have store id then before it can be used in the store\nit needs to be moved there with the _/v1/franchise-product/hq-to-store/{hqProductId}_ call.\nNote that the results here cannot be paginated or sorted and the amount of records returned is limited.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "franchise-product",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "warehouseId",
                  "value": "<integer>",
                  "description": "(Required) Supply the warehouse ID to get the pricing api price for."
                },
                {
                  "disabled": false,
                  "key": "customerId",
                  "value": "<integer>",
                  "description": "Customer ID. Used to calculate the pricing api price when provided."
                },
                {
                  "disabled": false,
                  "key": "nonStockProducts",
                  "value": "<string>",
                  "description": "Include or exclude non-stock products. Both will be returned by default."
                },
                {
                  "disabled": false,
                  "key": "isInStock",
                  "value": "<boolean>",
                  "description": "Return only products that are in stock."
                },
                {
                  "disabled": false,
                  "key": "take",
                  "value": "<integer>",
                  "description": "items to take, default: 20, max: 200"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "the filter parameter is explained in the `Filtering & Sorting` section on top of the Swagger documentation"
