{
  "opencollection": "1.0.0",
  "info": {
    "name": "assignments Assortment Permissions API",
    "version": "2.36.5"
  },
  "items": [
    {
      "info": {
        "name": "Permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Set / Update a permission",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/permissions",
            "params": [
              {
                "name": "entity",
                "value": "",
                "type": "query",
                "description": "values: 'product group' or 'product category'"
              }
            ]
          },
          "docs": "Some entities support setting up permissions on the user level. They include product groups and categpries.\nResponse is the userID of the updated user\n"
        },
        {
          "info": {
            "name": "Get user permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/permissions/:userID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "user ID"
              },
              {
                "name": "entity",
                "value": "",
                "type": "query",
                "description": "values: 'product group' or 'product category'"
              }
            ]
          },
          "docs": "Get user permissions"
        }
      ]
    }
  ],
  "bundled": true
}