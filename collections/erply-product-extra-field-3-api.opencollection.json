                "name": "id",
                "value": "",
                "type": "path",
                "description": "Product Extra Field ID"
              }
            ]
          },
          "docs": "Update a Product Extra Field"
        },
        {
          "info": {
            "name": "Move Product Extra Field",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/product/extra/field-3/:id/move",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Product Extra Field ID"
              }
            ]
          },
          "docs": "position has to be one of the following:  `before` | `after`"
        }
