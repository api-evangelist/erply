        {
          "info": {
            "name": "Delete Matrix Dimensions",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/matrix/dimension/:ids",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "path",
                "description": "semicolon delimited IDs"
              }
            ]
          },
          "docs": "Deleting a matrix dimension is not allowed if there are products using that dimension.\nDeleting a matrix dimension will also delete all the values of that dimension."
