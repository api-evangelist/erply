              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Result page size"
              },
              {
                "name": "pageNr",
                "value": "",
                "type": "query",
                "description": "Result page number"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting order. Supported values are: `id`, `deviceId`, `workorderId`, `date`, `name`, `createdAt`, `updatedAt`"
              }
            ]
