          "name": "Get products replacement information",
          "request": {
            "name": "Get products replacement information",
            "description": {
              "content": "Not to be mistaken with the product substituting feature. This feature is meant for complete replacement\nof old products (discontinued etc).\nA product cannot replace multiple products. Api can still return multiple replacements however since\napi also returns inherited replacements from the replaced products.",
              "type": "text/plain"
            },
            "url": {
