            "description": {
              "content": "Not to be mistaken with the product substituting feature. This feature is meant for complete replacement\nof old products (discontinued etc).\nIf the replaced product has replacements on its own then the new product will also inherit all of them.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "product",
                ":newProductId",
                "replace",
                ":oldProductId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "newProductId",
                  "description": "(Required) product ID - product that replaces the other product"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "oldProductId",
                  "description": "(Required) product ID - product that will be replaced"
