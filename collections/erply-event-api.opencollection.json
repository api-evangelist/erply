                "description": "Event types"
              },
              {
                "name": "withTotalCount",
                "value": "",
                "type": "query",
                "description": "If total matching record count should be return in response header"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Result page size"
              },
              {
                "name": "pageNr",
