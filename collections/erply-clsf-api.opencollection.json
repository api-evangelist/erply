      "info": {
        "name": "clsf",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Look up priorities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/clsf/priority",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Priority ids"
              },
              {
                "name": "entity",
                "value": "",
                "type": "query",
                "description": "Entity for which priority should be returned (`raji`)"
              },
              {
                "name": "lang",
                "value": "",
                "type": "query",
                "description": "Language to use when sorting by name (`en`, `et`, `ru` etc.)"
              },
              {
                "name": "code",
                "value": "",
                "type": "query",
                "description": "Priority code to search for. Partial matching from the beginning of the code"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Result page size"
              },
              {
                "name": "pageNr",
                "value": "",
                "type": "query",
                "description": "Result page number"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting order. Supported values are: `id`, `name`. Defaults to `id`"
              }
            ]
          },
          "docs": "Look up priorities"
        },
        {
          "info": {
            "name": "Add a new priority",
            "type": "http"
          },
          "http": {
