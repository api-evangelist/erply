        {
          "id": "f3220c98-7f5d-4622-a47d-02d30dd6fc8a",
          "name": "Create Product Parameter Validation Rule",
          "request": {
            "name": "Create Product Parameter Validation Rule",
            "description": {
              "content": "The validation rule types are: REQUIRED,  MIN_LENGTH, MAX_LENGTH, MIN_VALUE, MAX_VALUE, INPUT_CASE, PRECISION\nRule \"value\" or whatever to call this: the numeric qualifier that goes hand in hand with that particular rule type. Eg. I specify that my parameter must have at least a minimum number of characters and that minimum number is 5.\nFor type REQUIRED, leave empty.\nFor type MIN_LENGTH, input the required minimum length as an integer.\nFor type MAX_LENGTH, input the required maximum length as an integer.\nFor type MIN_VALUE, input the minimum allowed value as a signed integer or decimal (eg. “0”, “-1”, “25.6”, “-9.999999” etc.)\nFor type MAX_VALUE, input the maximum allowed value as a signed integer or decimal.\nFor type INPUT_CASE, input 0 for \"LOWERCASE\" or 1 for “UPPERCASE”.\nFor type PRECISION, input the number of allowed decimal places as an integer (eg. “0”, “1”, or “2”)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "product",
                "parameter",
                "validation",
                "rule"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
