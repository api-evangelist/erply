          "info": {
            "name": "Look up labels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/clsf/label",
            "params": [
              {
                "name": "entity",
                "value": "",
                "type": "query",
                "description": "Object type for which labels should be returned. One of [workorder raji]"
              },
              {
                "name": "labelType",
                "value": "",
                "type": "query",
                "description": "Label type code for which labels should be returned"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Label ids"
              },
              {
                "name": "lang",
                "value": "",
                "type": "query",
                "description": "Language to use when sorting by name (`en`, `et`, `ru` etc.)"
              },
              {
                "name": "code",
                "value": "",
                "type": "query",
                "description": "Label code to search for. Partial matching from the beginning of the code"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Result page size"
              },
              {
                "name": "pageNr",
                "value": "",
                "type": "query",
                "description": "Result page number"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting order. Supported values are: `id`, `name`. Defaults to `id`"
              }
            ]
          },
          "docs": "Look up labels"
